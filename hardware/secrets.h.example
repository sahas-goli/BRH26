// Copy to hardware/secrets.h (gitignored) and flash per badge.
// Mirror the same hex in Vercel / web HOTP_SECRETS JSON, e.g.
//   HOTP_SECRETS={"badge1":"<hex>"}
//
// Secret must match web/lib/hotp.ts parseHotpSecret (hex or ASCII).
// RFC 4226 test secret as ASCII would be: 12345678901234567890

#pragma once
#include <Arduino.h>

// 20-byte example — REPLACE before flash. Do not commit real secrets.h.
static const uint8_t HOTP_SECRET[] = {
  0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x30,
  0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x30
};
static const uint8_t HOTP_SECRET_LEN = sizeof(HOTP_SECRET);

// Optional label for logs only (not shown on the badge).
static const char BADGE_ID[] = "badge1";
